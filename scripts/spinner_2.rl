  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
      لاحقة = الوسائط[فهرس_الهدف + 1]
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '--suf' requires a لاحقة argument after it")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing لاحقة after '--suf'")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان --json مقدماً
//     وضع مخرجات JSON
إذا الوسائط.يحتوي_على("--json") {
  وضع_JSON = صحيح
  هادئ = صحيح
}

// --- التحقق مما إذا كان --إشعار مقدماً
//     إشعار سطح المكتب عند الانتهاء
إذا الوسائط.يحتوي_على("--إشعار") {
  إذا اسم_النظام() != "linux" {
    اطبع_خطأ("\e[31merror:\e[0m --إشعار is only supported on Linux")
    اخرج(2)
  }
  إشعار = صحيح
}

// --- التحقق مما إذا كان الخيار -F
//     رسائل متحركة (مفصولة بفواصل)
إذا الوسائط.يحتوي_على("-F") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-F")
  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
      رسائل_مخصصة = الوسائط[فهرس_الهدف + 1]
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '-F' requires a messages argument after it")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing messages after '-F'")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان -L مقدماً
//     عرض سطر المخرجات المباشر
إذا الوسائط.يحتوي_على("-L") {
  عرض_سطر_مباشر = صحيح
}

// --- التحقق مما إذا كان الخيار -C
//     مستخدماً بشكل صحيح أم لا
//     0 معاملات: لون عشوائي لكل إطار
//     1 معامل: لون للإطارات فقط
//     2 معاملات: لون للإطارات والرسائل
//     3 معاملات: إطار، رسالة، انتهاء (_ = يستخدم الثاني)
//     4 معاملات: إطار، رسالة، انتهاء، سهم (_ = يستخدم الأول)
//     5 معاملات: إطار، رسالة، انتهاء، سهم، مخرجات (_ = يستخدم الأول)
إذا الوسائط.يحتوي_على("-C") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-C")
  // -C آخر معامل -> الوضع العشوائي
  إذا الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر() {
    لون_عشوائي = صحيح
  } وإلا {
    أعلن string أول = الوسائط[فهرس_الهدف + 1]
    إذا أول.يبدأ_بـ("-") {
      لون_عشوائي = صحيح
    } وإلا {
      // المعامل الأول -> لون الإطار
      طابق أول {
        "random" => { لون_عشوائي = صحيح }
        "black" => { لون_الإطار = "30" }
        "red" => { لون_الإطار = "31" }
        "green" => { لون_الإطار = "32" }
        "yellow" => { لون_الإطار = "33" }
        "blue" => { لون_الإطار = "34" }
        "magenta" => { لون_الإطار = "35" }
        "cyan" => { لون_الإطار = "36" }
        "white" => { لون_الإطار = "37" }
        _ => {
          اطبع_خطأ(format("\e[31merror:\e[0m '{}' is not a valid color\n  valid colors: random | black | red | green | yellow | blue | magenta | cyan | white", أول))
          اخرج(4)
        }
      }
      أعلن bool وجد2 = ليس_صحيح
      أعلن bool وجد3 = ليس_صحيح
      أعلن bool وجد4 = ليس_صحيح
      // المعامل الثاني -> لون الرسالة
      إذا فهرس_الهدف + 2 < الوسائط.الطول() و !الوسائط[فهرس_الهدف + 2].يبدأ_بـ("-") {
        أعلن string ثان = الوسائط[فهرس_الهدف + 2]
        طابق ثان {
          "black" => { لون_الرسالة = "30"; وجد2 = صحيح }
          "red" => { لون_الرسالة = "31"; وجد2 = صحيح }
          "green" => { لون_الرسالة = "32"; وجد2 = صحيح }
          "yellow" => { لون_الرسالة = "33"; وجد2 = صحيح }
          "blue" => { لون_الرسالة = "34"; وجد2 = صحيح }
          "magenta" => { لون_الرسالة = "35"; وجد2 = صحيح }
          "cyan" => { لون_الرسالة = "36"; وجد2 = صحيح }
          "white" => { لون_الرسالة = "37"; وجد2 = صحيح }
          _ => {
            اطبع_خطأ(format("\e[31merror:\e[0m '{}' is not a valid color for messages\n  valid colors: black | red | green | yellow | blue | magenta | cyan | white", ثان))
            اخرج(4)
          }
        }
      }
      // المعامل الثالث -> لون الانتهاء (_ = يستخدم الثاني)
      إذا وجد2 و فهرس_الهدف + 3 < الوسائط.الطول() {
        أعلن string ثالث = الوسائط[فهرس_الهدف + 3]
        إذا ثالث == "_" {
          لون_الانتهاء = لون_الرسالة
          وجد3 = صحيح
        } وإلا إذا !ثالث.يبدأ_بـ("-") {
          طابق ثالث {
            "black" => { لون_الانتهاء = "30"; وجد3 = صحيح }
            "red" => { لون_الانتهاء = "31"; وجد3 = صحيح }
            "green" => { لون_الانتهاء = "32"; وجد3 = صحيح }
            "yellow" => { لون_الانتهاء = "33"; وجد3 = صحيح }
            "blue" => { لون_الانتهاء = "34"; وجد3 = صحيح }
            "magenta" => { لون_الانتهاء = "35"; وجد3 = صحيح }
            "cyan" => { لون_الانتهاء = "36"; وجد3 = صحيح }
            "white" => { لون_الانتهاء = "37"; وجد3 = صحيح }
            _ => {
              اطبع_خطأ(format("\e[31merror:\e[0m '{}' is not a valid color for finish الرسالة\n  valid colors: _ | black | red | green | yellow | blue | magenta | cyan | white", ثالث))
              اخرج(4)
            }
          }
        }
      }
      // المعامل الرابع -> لون السهم (_ = يستخدم الأول)
      إذا وجد3 و فهرس_الهدف + 4 < الوسائط.الطول() {
        أعلن string رابع = الوسائط[فهرس_الهدف + 4]
        إذا رابع == "_" {
          إذا لون_الإطار != "" {
            لون_السهم = لون_الإطار
          } وإلا إذا لون_عشوائي {
            لون_السهم = قوس_قزح[0]
          }
          وجد4 = صحيح
        } وإلا إذا !رابع.يبدأ_بـ("-") {
          طابق رابع {
            "black" => { لون_السهم = "30"; وجد4 = صحيح }
            "red" => { لون_السهم = "31"; وجد4 = صحيح }
            "green" => { لون_السهم = "32"; وجد4 = صحيح }
            "yellow" => { لون_السهم = "33"; وجد4 = صحيح }
            "blue" => { لون_السهم = "34"; وجد4 = صحيح }
            "magenta" => { لون_السهم = "35"; وجد4 = صحيح }
            "cyan" => { لون_السهم = "36"; وجد4 = صحيح }
            "white" => { لون_السهم = "37"; وجد4 = صحيح }
            _ => {
              اطبع_خطأ(format("\e[31merror:\e[0m '{}' is not a valid color for arrow\n  valid colors: _ | black | red | green | yellow | blue | magenta | cyan | white", رابع))
              اخرج(4)
            }
          }
        }
      }
      // المعامل الخامس -> لون المخرجات (_ = يستخدم الأول)
      إذا وجد4 و فهرس_الهدف + 5 < الوسائط.الطول() {
        أعلن string خامس = الوسائط[فهرس_الهدف + 5]
        إذا خامس == "_" {
          إذا لون_الإطار != "" {
            لون_المخرجات = لون_الإطار
          } وإلا إذا لون_عشوائي {
            لون_المخرجات = قوس_قزح[0]
          }
        } وإلا إذا !خامس.يبدأ_بـ("-") {
          طابق خامس {
            "black" => { لون_المخرجات = "30" }
            "red" => { لون_المخرجات = "31" }
            "green" => { لون_المخرجات = "32" }
            "yellow" => { لون_المخرجات = "33" }
            "blue" => { لون_المخرجات = "34" }
            "magenta" => { لون_المخرجات = "35" }
            "cyan" => { لون_المخرجات = "36" }
            "white" => { لون_المخرجات = "37" }
            _ => {
              اطبع_خطأ(format("\e[31merror:\e[0m '{}' is not a valid color for output\n  valid colors: _ | black | red | green | yellow | blue | magenta | cyan | white", خامس))
              اخرج(4)
            }
          }
        }
      }
    }
  }
}

طابق نمط {
  0 => { الإطارات = dots }
  1 => { الإطارات = wave }
  2 => { الإطارات = pulse }
  3 => { الإطارات = fill }
  4 => { الإطارات = bounce }
  5 => { الإطارات = heavy }
  6 => { الإطارات = line }
  7 => { الإطارات = arc }
  8 => { الإطارات = dots2 }
  9 => { الإطارات = marks }
  10 => { الإطارات = star }
  11 => { الإطارات = toggle }
  12 => { الإطارات = bounce2 }
  13 => { الإطارات = clock }
}

إذا معكوس {
  الإطارات = الإطارات.عكس_المصفوفة()
}

// --- تطبيق الإطارات المخصصة إذا تم تقديم -f
إذا إطارات_مخصصة != "" {
  أعلن arr[string] مخصصة = split(إطارات_مخصصة, " ")
  إذا مخصصة.الطول() == 0 {
    اطبع_خطأ("\e[31merror:\e[0m '-f' requires at least one frame")
    اخرج(4)
  }
  الإطارات = مخصصة
}

// --- تطبيق الرسائل المتحركة إذا تم تقديم -F
أعلن arr[string] رسائل_متحركة = []
إذا رسائل_مخصصة != "" {
  رسائل_متحركة = split(رسائل_مخصصة, ",")
  إذا رسائل_متحركة.الطول() == 0 {
    اطبع_خطأ("\e[31merror:\e[0m '-F' requires at least one الرسالة")
    اخرج(4)
  }
}

// --- كشف الطرفية
//     هل_mensh() يفحص stdin، يُستخدم لإظهار/إخفاء المؤشر فقط
أعلن bool هل_terminaux = هل_mensh()

// --- وضع ملفّ العمليات (-e)
//     runs command with spinner
إذا الأمر != "" {
  أعلن string الملف_المخرجات = format("/tmp/spinner_out_{}", يعرف())
  أعلن string ملف_لف = format("({}) > {} 2>&1", الأمر, الملف_المخرجات)
  أعلن result[عدد] نتيجة_معرف = نفّذ_في_الخلفية(ملف_لف)
  إذا نتيجة_معرف.is_err() {
    اطبع_خطأ(format("\e[31merror:\e[0m failed to start command: {}", الأمر))
    اخرج(1)
  }
  أعلن عدد معرف_خلفي = نتيجة_معرف.result_unwrap()
  أعلن عدد وقت_بداية = وقت_الآن()
  أعلن عدد مهلة_مللي = -1
  إذا مهلة_الثوان > 0 {
    مهلة_مللي = مهلة_الثوان * 1000
  }
  أعلن string آخر_سطر = ""
  إذا !هادئ {
    اطبع("\e[?25l")
  }
  أعلن عدد ع = 0
  أعلن bool انتهى_بـ_مهلة = ليس_صحيح
  بينما هل_يعمل(معرف_خلفي) {
    // فحص المهلة
    إذا مهلة_مللي > 0 {
      أعلن عدد منقضية = وقت_الآن() - وقت_بداية
      إذا منقضية >= مهلة_مللي {
        اقتل_المعرف(معرف_خلفي)
        انتهى_بـ_مهلة = صحيح
        توقف
      }
    }
    // تحريك الإطار
    إذا !هادئ {
      أعلن string لون_إ = لون_الإطار
      إذا لون_عشوائي {
        لون_إ = قوس_قزح[حساب(ع, قوس_قزح.الطول())?]
      }
      أعلن string رسالة_لعرض = الرسالة
      إذا رسائل_متحركة.الطول() > 0 {
        رسالة_لعرض = رسائل_متحركة[حساب(ع, رسائل_متحركة.الطول())?]
      }
      أعلن string بادئة_لون = ""
      إذا لون_إ != "" {
        بادئة_لون = format("\e[{}m", لون_إ)
      }
      أعلن string إط_مخرجات = format("{}{}\e[0m", بادئة_لون, الإطارات[حساب(ع, الإطارات.الطول())?])
      إذا رسالة_لعرض != "" {
        أعلن string بادئة_رسالة = ""
        إذا لون_الرسالة != "" {
          بادئة_رسالة = format("\e[{}m", لون_الرسالة)
        }
        أعلن string رسالة_مخرجات = format(" {}{}\e[0m", بادئة_رسالة, رسالة_لعرض)
        اطبع(format("\r{}{}{}\e[0m{}", بادئة, إط_مخرجات, رسالة_مخرجات, لاحقة))
      } وإلا {
        اطبع(format("\r{}{}{}", بادئة, إط_مخرجات, لاحقة))
      }
      // عرض سطر المخرجات المباشر
      إذا عرض_سطر_مباشر {
        أعلن result[string] ذيل = نفّذ(format("ذيل -1 {}", الملف_المخرجات))
        إذا !ذيل.is_err() {
          أعلن string line = ذيل.result_unwrap().تقلم()
          إذا line != "" و line != آخر_سطر {
            آخر_سطر = line
            أعلن string نص_سهم = "↳"
            إذا لون_السهم != "" {
              نص_سهم = format("\e[{}m↳\e[0m", لون_السهم)
            }
            أعلن string نص_سطر = line
            إذا لون_المخرجات != "" {
              نص_سطر = format("\e[{}m{}\e[0m", لون_المخرجات, line)
            }
            أعلن string نص_مخرجات = format("{} {}", نص_سهم, نص_سطر)
            اطبع(format("\n\e[2K\r{}\e[A", نص_مخرجات))
          }
        }
      }
      flush_terminaux()
    }
    ع += 1
    نَم(تأخير)
  }
  أعلن result[عدد] نتيجة_خروج = انتظر_المعرف(معرف_خلفي)
  أعلن عدد رمز_الخروج = 0
  إذا !نتيجة_خروج.is_err() {
    رمز_الخروج = نتيجة_خروج.result_unwrap()
  }
  إذا انتهى_بـ_مهلة {
    رمز_الخروج = 124
  }
  أعلن عدد مدة_مللي = وقت_الآن() - وقت_بداية
  أعلن عدد مدة_ثوان = مدة_مللي / 1000
  أعلن عدد مدة_كسور = حساب((مدة_مللي / 100), 10).result_unwrap()
  أعلن string مدة_نص = format("{}.{}s", مدة_ثوان, مدة_كسور)
  إذا !هادئ {
    اطبع("\e[?25h")
    اطبع("\e[2K\r")
  }
  أعلن string لون_نهاية = لون_الانتهاء
  إذا لون_نهاية == "" {
    لون_نهاية = لون_الرسالة
  }
  أعلن string رسالة_نهاية = رسالة_الانتهاء
  إذا انتهى_بـ_مهلة {
    رسالة_نهاية = "Timed out"
    لون_نهاية = "31"
  }
  إذا وضع_JSON {
    // بناء مخرجات JSON
    أعلن string حالة = "failed"
    إذا رمز_الخروج == 0 {
      حالة = "done"
    }
    أعلن string مخرجات_هروب = ""
    إذا عرض_المخرجات {
      أعلن result[string] output = نفّذ(format("cat {}", الملف_المخرجات))
      إذا !output.is_err() {
        مخرجات_هروب = output.result_unwrap().تقلم()
      }
    }
    أعلن string نص_خروج = format("{}", رمز_الخروج)
    إذا رسالة_نهاية != "" و مخرجات_هروب != "" {
      اطبع(format("{\"حالة\":\"{}\",\"رمز_الخروج\":{},\"duration\":\"{}\",\"الرسالة\":\"{}\",\"output\":\"{}\"}\n", حالة, نص_خروج, مدة_نص, رسالة_نهاية, مخرجات_هروب))
    } وإلا إذا رسالة_نهاية != "" {
      اطبع(format("{\"حالة\":\"{}\",\"رمز_الخروج\":{},\"duration\":\"{}\",\"الرسالة\":\"{}\"}\n", حالة, نص_خروج, مدة_نص, رسالة_نهاية))
    } وإلا إذا مخرجات_هروب != "" {
      اطبع(format("{\"حالة\":\"{}\",\"رمز_الخروج\":{},\"duration\":\"{}\",\"output\":\"{}\"}\n", حالة, نص_خروج, مدة_نص, مخرجات_هروب))
    } وإلا {
      اطبع(format("{\"حالة\":\"{}\",\"رمز_الخروج\":{},\"duration\":\"{}\"}\n", حالة, نص_خروج, مدة_نص))
    }
  } وإلا {
    إذا رمز_الخروج == 0 {
      إذا لون_نهاية != "" {
        اطبع(format("\e[{}m✓\e[0m", لون_نهاية))
      } وإلا {
        اطبع("\e[32m✓\e[0m")
      }
      إذا رسالة_نهاية != "" {
        إذا لون_نهاية != "" {
          اطبع(format(" \e[{}m{}\e[0m", لون_نهاية, رسالة_نهاية))
        } وإلا {
          اطبع(format(" {}", رسالة_نهاية))
        }
      } وإلا {
        اطبع(" Done")
      }
      اطبع(format(" ({})\n", مدة_نص))
      إذا عرض_المخرجات {
        أعلن result[string] output = نفّذ(format("cat {}", الملف_المخرجات))
        إذا !output.is_err() {
          أعلن string نص_مخرجات = output.result_unwrap().تقلم()
          إذا نص_مخرجات != "" {
            اطبع(format("{}\n", نص_مخرجات))
          }
        }
      }
    } وإلا {
      اطبع("\e[31m✗\e[0m")
      إذا رسالة_نهاية != "" {
        إذا لون_نهاية != "" {
          اطبع(format(" \e[{}m{}\e[0m", لون_نهاية, رسالة_نهاية))
        } وإلا {
          اطبع(format(" {}", رسالة_نهاية))
        }
      } وإلا {
        اطبع(" Failed")
      }
      اطبع(format(" (exit code {}) ({})\n", رمز_الخروج, مدة_نص))
      أعلن result[string] output = نفّذ(format("cat {}", الملف_المخرجات))
      إذا !output.is_err() {
        أعلن string نص_مخرجات = output.result_unwrap().تقلم()
        إذا نص_مخرجات != "" {
          اطبع(format("\n{}\n", نص_مخرجات))
        }
      }
    }
  }
  نفّذ(format("rm -f {}", الملف_المخرجات))
  // إشعار
  إذا إشعار و رمز_الخروج == 0 {
    أعلن string رسالة_إشعار = "Command completed"
    إذا رسالة_نهاية != "" {
      رسالة_إشعار = رسالة_نهاية
    }
    نفّذ(format("إشعار-send 'Spinner' '{}'", رسالة_إشعار))
  }
  اخرج(رمز_الخروج)
}

// --- طباعة المصفوفة باستمرار
//     من النقاط/الحركات عندما لا
//     يُعطى عداً (-n)
إذا عدد_الدورات != -1 {
  إذا !هادئ {
    اطبع("\e[?25l")
  }
  أعلن عدد ع = 0
  بينما عدد_الدورات > 0 {
    إذا !هادئ {
      أعلن string لون_إ = لون_الإطار
      إذا لون_عشوائي {
        لون_إ = قوس_قزح[حساب(ع, قوس_قزح.الطول())?]
      }
      أعلن string رسالة_لعرض = الرسالة
      إذا رسائل_متحركة.الطول() > 0 {
        رسالة_لعرض = رسائل_متحركة[حساب(ع, رسائل_متحركة.الطول())?]
      }
      أعلن string بادئة_لون = ""
      إذا لون_إ != "" {
        بادئة_لون = format("\e[{}m", لون_إ)
      }
      أعلن string إط_مخرجات = format("{}{}\e[0m", بادئة_لون, الإطارات[حساب(ع, الإطارات.الطول())?])
      إذا رسالة_لعرض != "" {
        أعلن string بادئة_رسالة = ""
        إذا لون_الرسالة != "" {
          بادئة_رسالة = format("\e[{}m", لون_الرسالة)
        }
        أعلن string رسالة_مخرجات = format(" {}{}\e[0m", بادئة_رسالة, رسالة_لعرض)
        اطبع(format("\r{}{}{}\e[0m{}", بادئة, إط_مخرجات, رسالة_مخرجات, لاحقة))
      } وإلا {
        اطبع(format("\r{}{}{}", بادئة, إط_مخرجات, لاحقة))
      }
      flush_terminaux()
    }
    ع += 1
    عدد_الدورات -= 1
    نَم(تأخير)
  }
  إذا !هادئ {
    اطبع("\e[?25h")
    اطبع("\e[2K\r")
  }
  أعلن string لون_نهاية = لون_الانتهاء
  إذا لون_نهاية == "" {
    لون_نهاية = لون_الرسالة
  }
  إذا لون_نهاية != "" و رسالة_الانتهاء != "" {
    اطبع(format("\e[{}m{}\e[0m\n", لون_نهاية, رسالة_الانتهاء))
  } وإلا إذا رسالة_الانتهاء != "" {
    اطبع(format("{}\n", رسالة_الانتهاء))
  } وإلا {
    اطبع("\n")
  }
} وإلا {
  أعلن عدد ع = 0
  بينما صحيح {
    إذا !هادئ {
      أعلن string لون_إ = لون_الإطار
      إذا لون_عشوائي {
        لون_إ = قوس_قزح[حساب(ع, قوس_قزح.الطول())?]
      }
      أعلن string رسالة_لعرض = الرسالة
      إذا رسائل_متحركة.الطول() > 0 {
        رسالة_لعرض = رسائل_متحركة[حساب(ع, رسائل_متحركة.الطول())?]
      }
      أعلن string بادئة_لون = ""
      إذا لون_إ != "" {
        بادئة_لون = format("\e[{}m", لون_إ)
      }
      أعلن string إط_مخرجات = format("{}{}\e[0m", بادئة_لون, الإطارات[حساب(ع, الإطارات.الطول())?])
      إذا رسالة_لعرض != "" {
        أعلن string بادئة_رسالة = ""
        إذا لون_الرسالة != "" {
          بادئة_رسالة = format("\e[{}m", لون_الرسالة)
        }
        أعلن string رسالة_مخرجات = format(" {}{}\e[0m", بادئة_رسالة, رسالة_لعرض)
        اطبع(format("\r{}{}{}\e[0m{}", بادئة, إط_مخرجات, رسالة_مخرجات, لاحقة))
      } وإلا {
        اطبع(format("\r{}{}{}", بادئة, إط_مخرجات, لاحقة))
      }
      flush_terminaux()
    }
    ع += 1
    نَم(تأخير)
  }
}
