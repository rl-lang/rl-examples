// spinner - © Mohamed Gonem

get term_flush from std::term
get sleep, args, exit, pid, exec, exec_background, wait_pid, process_running, term_pid, os_name from std::process
get print, eprintln, isatty from std::io
get format, starts_with, trim, split from std::str
get arr_reverse, arr_contains, arr_last, arr_index_of, len from std::array
get to_int from std::types
get result_unwrap, is_err from std::res
get mod from std::math
get time_now_ms from std::time


// --- وظائف مساعدة
دالة اطبع(نص النص) -> فارغ { print(النص) }
دالة اطبع_خطأ(نص النص) -> فارغ { eprintln(النص) }
دالة نَم(عدد الوقت) -> فارغ { sleep(الوقت) }
دالة اخرج(عدد الرمز) -> فارغ { exit(الرمز) }
دالة يعرف() -> عدد { pid() }
دالة نفّذ(نص الأمر) -> نتيجة[نص] { exec(الأمر) }
دالة نفّذ_في_الخلفية(نص الأمر) -> نتيجة[عدد] { exec_background(الأمر) }
دالة انتظر_المعرف(عدد المعرف) -> نتيجة[عدد] { wait_pid(المعرف) }
دالة هل_يعمل(عدد المعرف) -> منطقي { process_running(المعرف) }
دالة اقتل_المعرف(عدد المعرف) -> فارغ { term_pid(المعرف) }
دالة اسم_النظام() -> نص { os_name() }
دالة يحتوي_على(مصفوفة[نص] المصفوفة, نص العنصر) -> منطقي { result_unwrap(arr_contains(المصفوفة, العنصر)) }
دالة عنصر_آخر(مصفوفة[نص] المصفوفة) -> نص { result_unwrap(arr_last(المصفوفة)) }
دالة فهرس_من(مصفوفة[نص] المصفوفة, نص العنصر) -> عدد { result_unwrap(arr_index_of(المصفوفة, العنصر)) }
دالة عكس_المصفوفة(مصفوفة[نص] المصفوفة) -> مصفوفة[نص] { result_unwrap(arr_reverse(المصفوفة)) }
دالة الطول(مصفوفة[نص] المصفوفة) -> عدد { result_unwrap(len(المصفوفة)) }
دالة يبدأ_بـ(نص النص, نص البادئة) -> منطقي { starts_with(النص, البادئة) }
دالة تقلم(نص النص) -> نص { trim(النص) }
دالة تقسيم(نص النص, نص الفاصل) -> مصفوفة[نص] { split(النص, الفاصل) }
دالة الى_عدد(نص النص) -> نتيجة[عدد] { to_int(النص) }
دالة حساب(عدد أ, عدد ب) -> نتيجة[عدد] { mod(أ, ب) }
دالة وقت_الآن() -> عدد { time_now_ms() }
دالة هل_mensh() -> منطقي { isatty() }
دالة flush_terminaux() -> فارغ { term_flush() }
// ---المغيرات العامة
أعلن منطقي معكوس = ليس_صحيح
أعلن عدد نمط = 0
أعلن مصفوفة[نص] الإطارات = []
أعلن عدد عدد_الدورات = -1
أعلن نص الرسالة = ""
أعلن نص رسالة_الانتهاء = ""
أعلن منطقي لون_عشوائي = ليس_صحيح
أعلن نص لون_الإطار = ""
أعلن نص لون_الرسالة = ""
أعلن نص لون_الانتهاء = ""
أعلن نص الأمر = ""
أعلن منطقي عرض_المخرجات = ليس_صحيح
أعلن نص لون_السهم = ""
أعلن نص لون_المخرجات = ""
أعلن مصفوفة[نص] قوس_قزح = ["31", "32", "33", "34", "35", "36"]
أعلن عدد مهلة_الثوان = -1
أعلن منطقي هادئ = ليس_صحيح
أعلن عدد تأخير = 100
أعلن نص إطارات_مخصصة = ""
أعلن نص بادئة = ""
أعلن نص لاحقة = ""
أعلن منطقي وضع_JSON = ليس_صحيح
أعلن منطقي إشعار = ليس_صحيح
أعلن نص رسائل_مخصصة = ""
أعلن منطقي عرض_سطر_مباشر = ليس_صحيح

// --- مجموعة أساسية من الحركات
أعلن dots = ["⠋", "⠙", "⠸", "⢰", "⣠", "⣄", "⡆", "⠇"]
أعلن wave = ["⠀", "⠄", "⠆", "⠇", "⠏", "⠗", "⠿", "⣿", "⣷", "⣶", "⣦", "⣤", "⣄", "⣀", "⠤", "⠐"]
أعلن pulse = ["⣀", "⣤", "⣶", "⣾", "⣿", "⣶", "⣤", "⣀"]
أعلن fill = ["⠀", "⡀", "⣀", "⣄", "⣤", "⣦", "⣴", "⣼", "⣶", "⣾", "⣿"]
أعلن bounce = ["⠁", "⠈", "⠐", "⠠", "⡀", "⢀", "⠠", "⠐", "⠈"]
أعلن heavy = ["⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"]
أعلن line = ["-", "\\", "|", "/"]
أعلن arc = ["◜", "◠", "◝", "◞", "◡", "◟"]
أعلن dots2 = ["⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"]
أعلن marks = [" ", "▹", "▸", "▹", " "]
أعلن star = ["✶", "✳", "✴", "✳"]
أعلن toggle = ["□", "■"]
أعلن bounce2 = ["⠁", "⠂", "⠄", "⡀", "⢀", "⠠", "⠐", "⠈"]
أعلن clock = ["🕐", "🕑", "🕒", "🕓", "🕔", "🕕", "🕖", "🕗", "🕘", "🕙", "🕚", "🕛"]

أعلن الوسائط = args()
// ---المغيرات العامة
// --- التحقق مما إذا كان قد تم تقديم -h
//     ثم طباعة الاستخدام والخروج
إذا الوسائط.يحتوي_على("-h") {
  اطبع("\e[1mspinner\e[0m - دوار terminaux متكامل مع لفافة العمليات\n")
  اطبع("\n")
  اطبع("دوار terminaux قابل للتخصيص لأدوات سطر الأوامر.\n")
  اطبع("يعرض مؤشرات تحميل متحركة مع دعم الألوان ولفة العمليات\n")
  اطبع("والمخرجات المباشرة وتتبع التقدم.\n")
  اطبع("\n")
  اطبع("\e[36mالاستخدام:\e[0m spinner [الخيارات]\n")
  اطبع("\n")
  اطبع("\e[36mالحركة:\e[0m\n")
  اطبع("  \e[33m-s\e[0m \e[1m<النمط>\e[0m     نمط الحركة (انظر الأنماط أدناه)\n")
  اطبع("  \e[33m-r\e[0m             عكس اتجاه الحركة\n")
  اطبع("  \e[33m-d\e[0m \e[1m<مللي>\e[0m       التأخير بين الإطارات (الافتراضي: 100مللي)\n")
  اطبع("  \e[33m-f\e[0m \e[1m<أ ب ج>\e[0m      إطارات مخصصة (مفصولة بمسافة)\n")
  اطبع("\n")
  اطبع("\e[36mالرسالة:\e[0m\n")
  اطبع("  \e[33m-m\e[0m \e[1m<النص>\e[0m      نص لعرضه بجانب الدوار\n")
  اطبع("  \e[33m-M\e[0m \e[1m<النص>\e[0m      نص لعرضه بعد انتهاء الدوار\n")
  اطبع("  \e[33m-F\e[0m \e[1m<أ,ب,ج>\e[0m     رسائل متحركة (مفصولة بفاصلة)\n")
  اطبع("\n")
  اطبع("\e[36mلفة العمليات:\e[0m\n")
  اطبع("  \e[33m-e\e[0m \e[1m<الأمر>\e[0m     تشغيل أمر مع الدوار (يلتقط المخرجات)\n")
  اطبع("  \e[33m-o\e[0m             عرض المخرجات عند النجاح (يُعرض دائماً عند الفشل)\n")
  اطبع("  \e[33m-L\e[0m             عرض سطر المخرجات المباشر من الأمر -e\n")
  اطبع("  \e[33m-t\e[0m \e[1m<الثوان>\e[0m     المهلة: إيقاف الأمر بعد N ثوان\n")
  اطبع("\n")
  اطبع("\e[36mالمخرجات:\e[0m\n")
  اطبع("  \e[33m--json\e[0m         مخرجات JSON\n")
  اطبع("  \e[33m--notify\e[0m       إشعار سطح مكتب عند النجاح (Linux فقط)\n")
  اطبع("  \e[33m-q\e[0m             الوضع الهادئ: إخفاء الحركة\n")
  اطبع("\n")
  اطبع("\e[36mالمظهر:\e[0m\n")
  اطبع("  \e[33m-C\e[0m \e[1m[الألوان]\e[0m   وضع الألوان (انظر الألوان أدناه)\n")
  اطبع("  \e[33m--pre\e[0m \e[1m<النص>\e[0m   بادئة قبل الدوار\n")
  اطبع("  \e[33m--suf\e[0m \e[1m<النص>\e[0m   لاحقة بعد الدوار\n")
  اطبع("\n")
  اطبع("\e[36mمتنوع:\e[0m\n")
  اطبع("  \e[33m-n\e[0m \e[1m<العدد>\e[0m     تشغيل لمدة N دورة، ثم الإيقاف\n")
  اطبع("  \e[33m-h\e[0m             عرض هذه المساعدة\n")
  اطبع("\n")
  اطبع("\e[36mأوضاع الألوان:\e[0m\n")
  اطبع("  \e[33m-C\e[0m              لون عشوائي لكل إطار\n")
  اطبع("  \e[33m-C\e[0m \e[1m<اللون>\e[0m      لون واحد للإطارات\n")
  اطبع("  \e[33m-C\e[0m \e[1m<إ> <ر>\e[0m      ألوان للإطارات والرسائل\n")
  اطبع("  \e[33m-C\e[0m \e[1m<إ> <ر> <و>\e[0m  ألوان الإطارات والرسائل والانتهاء\n")
  اطبع("  \e[33m-C\e[0m \e[1m<إ> <ر> <و> <س> <خ>\e[0m  + ألوان السهم والمخرجات\n")
  اطبع("  \e[33m-C\e[0m \e[1mrandom <ر>\e[0m  إطارات عشوائية مع رسائل ملونة\n")
  اطبع("  استخدم \e[1m_\e[0m للاستخدام البديل: 3=_ يستخدم 2، 4/5=_ يستخدم 1\n")
  اطبع("\n")
  اطبع("\e[36mالألوان:\e[0m random | black red green yellow blue magenta cyan white\n")
  اطبع("\n")
  اطبع("\e[36mالأنماط:\e[0m\n")
  اطبع("  \e[33mdots\e[0m \e[33mwave\e[0m \e[33mpulse\e[0m \e[33mfill\e[0m \e[33mbounce\e[0m \e[33mheavy\e[0m\n")
  اطبع("  \e[33mline\e[0m \e[33marc\e[0m \e[33mdots2\e[0m \e[33mmarks\e[0m \e[33mstar\e[0m \e[33mtoggle\e[0m \e[33mbounce2\e[0m \e[33mclock\e[0m\n")
  اطبع("\n")
  اطبع("\e[36mأمثلة:\e[0m\n")
  اطبع("  spinner -s wave -m \"جاري التحميل...\"\n")
  اطبع("  spinner -s pulse -n 50 -M \"تم!\"\n")
  اطبع("  spinner -C red -m \"جاري العمل...\"\n")
  اطبع("  spinner -C cyan magenta -m \"جاري البناء...\" -M \"اكتمل البناء\"\n")
  اطبع("  spinner -e \"make build\" -C red\n")
  اطبع("  spinner -e \"cargo test\" -m \"جاري الاختبارات\" -M \"نجحت الاختبارات\"\n")
  اطبع("  spinner -e \"make\" -L -C random cyan green _ red yellow\n")
  اطبع("\n")
  اطبع("\e[36mأكواد الخروج:\e[0m\n")
  اطبع("  \e[33m0\e[0m   نجاح\n")
  اطبع("  \e[33m1\e[0m   خطأ عام (فشل في بدء الأمر)\n")
  اطبع("  \e[33m2\e[0m   خطأ في الاستخدام (خيار غير صالح)\n")
  اطبع("  \e[33m3\e[0m   ناقص معامل (مثلاً -e بدون أمر)\n")
  اطبع("  \e[33m4\e[0m   قيمة غير صالحة (نمط أو لون غير معروف)\n")
  اطبع("  \e[33m124\e[0m انتهت مهلة الأمر (-t)\n")
  اطبع("\n")
  اخرج(0)
}

// --- التحقق مما إذا كان خيار
//     العكس مقدماً أم لا
إذا الوسائط.يحتوي_على("-r") {
  معكوس = صحيح
}

// --- التحقق مما إذا كان الخيار -s
//     مستخدماً بشكل صحيح أم لا
//     ثم تحليله
إذا الوسائط.يحتوي_على("-s") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-s")
  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
      طابق الوسائط[فهرس_الهدف + 1] {
        "dots" => { نمط = 0 }
        "wave" => { نمط = 1 }
        "pulse" => { نمط = 2 }
        "fill" => { نمط = 3 }
        "bounce" => { نمط = 4 }
        "heavy" => { نمط = 5 }
        "line" => { نمط = 6 }
        "arc" => { نمط = 7 }
        "dots2" => { نمط = 8 }
        "marks" => { نمط = 9 }
        "star" => { نمط = 10 }
        "toggle" => { نمط = 11 }
        "bounce2" => { نمط = 12 }
        "clock" => { نمط = 13 }
        _ => {
          اطبع_خطأ("\e[31merror:\e[0m '{}' is not a valid نمط\n  valid styles: dots wave pulse fill bounce heavy\n               line arc dots2 marks star toggle bounce2 clock")
          اخرج(4)
        }
      }
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '-s' requires a نمط argument\n  valid styles: dots wave pulse fill bounce heavy\n               line arc dots2 marks star toggle bounce2 clock")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing نمط after '-s'\n  valid styles: dots wave pulse fill bounce heavy\n               line arc dots2 marks star toggle bounce2 clock")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان الخيار -n
//     مستخدماً بشكل صحيح أم لا
إذا الوسائط.يحتوي_على("-n") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-n")
  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
        أعلن result[عدد] c = الوسائط[فهرس_الهدف + 1].الى_عدد()
        إذا c.is_err() {
          اطبع_خطأ(format("\e[31merror:\e[0m '-n' expected an integer, got '{}'", الوسائط[فهرس_الهدف + 1]))
          اخرج(4)
        } وإلا {
          أعلن عدد c = c.result_unwrap()
          إذا c > 0 {
            عدد_الدورات = c
          } وإلا {
            اطبع_خطأ(format("\e[31merror:\e[0m '-n' must be a positive integer, got {}", c))
            اخرج(4)
          }
        }
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '-n' requires a عدد_الدورات argument after it")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing عدد_الدورات after '-n'")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان الخيار -m
//     مستخدماً بشكل صحيح أم لا
//     ثم تحليله
إذا الوسائط.يحتوي_على("-m") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-m")
  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
      الرسالة = الوسائط[فهرس_الهدف + 1]
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '-m' requires a الرسالة argument after it")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing الرسالة after '-m'")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان الخيار -M
//     مستخدماً بشكل صحيح أم لا
//     ثم تحليله
إذا الوسائط.يحتوي_على("-M") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-M")
  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
      رسالة_الانتهاء = الوسائط[فهرس_الهدف + 1]
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '-M' requires a finish الرسالة argument after it")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing finish الرسالة after '-M'")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان الخيار -e
//     مستخدماً بشكل صحيح أم لا
//     تشغيل أمر مع المحرّك
إذا الوسائط.يحتوي_على("-e") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-e")
  إذا الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر() {
    اطبع_خطأ("\e[31merror:\e[0m '-e' requires a command argument after it")
    اخرج(3)
  } وإلا {
    الأمر = الوسائط[فهرس_الهدف + 1]
  }
}

// --- التحقق مما إذا كان -o مقدماً
//     عرض المخرجات القياسية عند النجاح
إذا الوسائط.يحتوي_على("-o") {
  عرض_المخرجات = صحيح
}

// --- التحقق مما إذا كان الخيار -t
//     المهلة بالثوان
إذا الوسائط.يحتوي_على("-t") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-t")
  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
      أعلن result[عدد] t = الوسائط[فهرس_الهدف + 1].الى_عدد()
      إذا t.is_err() {
        اطبع_خطأ(format("\e[31merror:\e[0m '-t' expected an integer, got '{}'", الوسائط[فهرس_الهدف + 1]))
        اخرج(4)
      } وإلا {
        أعلن عدد t = t.result_unwrap()
        إذا t > 0 {
          مهلة_الثوان = t
        } وإلا {
          اطبع_خطأ(format("\e[31merror:\e[0m '-t' must be a positive integer, got {}", t))
          اخرج(4)
        }
      }
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '-t' requires a seconds argument after it")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing seconds after '-t'")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان -q مقدماً
//     الوضع الهادئ - كتم الحركة
إذا الوسائط.يحتوي_على("-q") {
  هادئ = صحيح
}

// --- التحقق مما إذا كان الخيار -d
//     التأخير بين الإطارات بالمللي ثانية
إذا الوسائط.يحتوي_على("-d") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-d")
  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
      أعلن result[عدد] d = الوسائط[فهرس_الهدف + 1].الى_عدد()
      إذا d.is_err() {
        اطبع_خطأ(format("\e[31merror:\e[0m '-d' expected an integer, got '{}'", الوسائط[فهرس_الهدف + 1]))
        اخرج(4)
      } وإلا {
        أعلن عدد d = d.result_unwrap()
        إذا d > 0 {
          تأخير = d
        } وإلا {
          اطبع_خطأ(format("\e[31merror:\e[0m '-d' must be a positive integer, got {}", d))
          اخرج(4)
        }
      }
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '-d' requires a milliseconds argument after it")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing milliseconds after '-d'")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان الخيار -f
//     إطارات مخصصة (مفصولة بمسافات)
إذا الوسائط.يحتوي_على("-f") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("-f")
  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
      إطارات_مخصصة = الوسائط[فهرس_الهدف + 1]
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '-f' requires a الإطارات argument after it")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing الإطارات after '-f'")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان الخيار --pre
//     بادئة قبل المحرّك
إذا الوسائط.يحتوي_على("--pre") {
  أعلن فهرس_الهدف = الوسائط.فهرس_من("--pre")
  إذا !(الوسائط[فهرس_الهدف] == الوسائط.عنصر_آخر()) {
    إذا فهرس_الهدف + 1 < الوسائط.الطول() {
      بادئة = الوسائط[فهرس_الهدف + 1]
    } وإلا {
      اطبع_خطأ("\e[31merror:\e[0m '--pre' requires a بادئة argument after it")
      اخرج(3)
    }
  } وإلا {
    اطبع_خطأ("\e[31merror:\e[0m missing بادئة after '--pre'")
    اخرج(3)
  }
}

// --- التحقق مما إذا كان الخيار --suf
//     لاحقة بعد المحرّك
